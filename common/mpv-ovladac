#!/usr/bin/env python3
"""Ovládání běžícího mpv z telefonu (GSConnect / KDE Connect „Spustit příkaz“) nebo z terminálu.

  mpv-ovladac centr|sloupy|mix     dialogy z centru / ze sloupů / mix (jen 3.1, filmy 5.1)
  mpv-ovladac zadni-zap|zadni-vyp  zadní reproduktory zap / vyp (vyp = přimíchat do sloupů; jen 5.1)
  mpv-ovladac 220-zap|220-vyp      ubrat 220 Hz ve sloupech o 6 dB / vrátit (A/B „nafouklosti“, všechny režimy)
  mpv-ovladac zpet                 o 5 s zpět
  mpv-ovladac pauza                pauza / přehrát
  mpv-ovladac test                 jen ukáže v obraze nápis (ověření spojení)
  mpv-ovladac smycka               opakování úseku: 1× = začátek, 2× = konec (pak se úsek
                                   pořád opakuje), 3× = zrušit opakování

Komunikuje přes IPC socket mpv (input-ipc-server=~~/socket v mpv.conf).
"""
import json
import os
import socket
import subprocess
import sys

SOCK = os.path.expanduser("~/.config/mpv/socket")
CMDS = {
    "centr":  ["keypress", "F1"],
    "sloupy": ["keypress", "F2"],
    "mix":    ["keypress", "F3"],
    "zpet":   ["seek", -5],
    "pauza":  ["cycle", "pause"],
    "smycka": ["ab-loop"],
    "test":   ["show-text", "Ovládání z telefonu funguje"],
}

PARAMS = {  # parametry filtru room_eq_21 (zadni-* jen v 5.1)
    "zadni-zap": ([("fl_mix:Gain 2", 0.0), ("fr_mix:Gain 2", 0.0), ("rl_gain:Gain 1", 1.0), ("rr_gain:Gain 1", 1.0)], "Zadní: ZAP"),
    "zadni-vyp": ([("fl_mix:Gain 2", 0.707), ("fr_mix:Gain 2", 0.707), ("rl_gain:Gain 1", 0.0), ("rr_gain:Gain 1", 0.0)], "Zadní: VYP (hrají sloupy)"),
    "220-zap":   ([("fl224:Gain", -6.0), ("fr224:Gain", -6.0)], "220 Hz: UBRÁNO (−6 dB)"),
    "220-vyp":   ([("fl224:Gain", 0.0), ("fr224:Gain", 0.0)], "220 Hz: PŮVODNÍ"),
}


def mpv_send(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    s.connect(SOCK)
    s.sendall((json.dumps({"command": cmd}, ensure_ascii=False) + "\n").encode())
    s.close()


if len(sys.argv) == 2 and sys.argv[1] in PARAMS:
    params, text = PARAMS[sys.argv[1]]
    dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True).stdout or "[]")
    node = next((o["id"] for o in dump
                 if o.get("type", "").endswith(":Node")
                 and o.get("info", {}).get("props", {}).get("node.name") == "room_eq_21"), None)
    if node is None:
        print("Filtr room_eq_21 neběží (spusť ./setup.sh)")
        sys.exit(1)
    body = " ".join(f'"{k}" {v}' for k, v in params)
    r = subprocess.run(["pw-cli", "s", str(node), "Props", "{ params = [ " + body + " ] }"], capture_output=True, text=True)
    if r.returncode:
        print(r.stderr or r.stdout)
        sys.exit(1)
    try:
        mpv_send(["show-text", text])
    except OSError:
        pass
    subprocess.run(["notify-send", "-t", "2000", "Zvuk", text], capture_output=True)  # i když nehraje mpv
    print(text)
    sys.exit(0)

if len(sys.argv) != 2 or sys.argv[1] not in CMDS:
    print(__doc__)
    sys.exit(2)

try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    s.connect(SOCK)
    s.sendall((json.dumps({"command": CMDS[sys.argv[1]]}) + "\n").encode())
    if sys.argv[1] == "smycka":
        msg = {"command": ["show-text", "Smyčka: ${ab-loop-a} -> ${ab-loop-b}"]}
        s.sendall((json.dumps(msg, ensure_ascii=False) + "\n").encode())
    s.close()
except OSError as e:
    print(f"mpv neběží nebo nemá zapnuté ovládání ({e})")
    sys.exit(1)
